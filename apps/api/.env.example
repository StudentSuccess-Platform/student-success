
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/studentsuccess
# Startup connection attempts before the API gives up connecting (it keeps serving either way)
DB_CONNECT_RETRIES=5

CORS_ORIGIN=http://localhost:5173

# LLM_PROVIDER: openai | ollama | mock (mock = deterministic offline answers for demos and tests)
# At startup, openai without a key/model or without a connection falls back to ollama; unset also means ollama.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
# Model used when the API falls back to ollama and LLM_MODEL is empty or a cloud model name
OLLAMA_MODEL=llama3.2
# Milliseconds to wait for the AI before the manual fallback is offered
AI_TIMEOUT_MS=15000

# Cloud provider keys are configured only when required
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Authentication
JWT_SECRET=your-dev-secret-key-here
JWT_EXPIRES_IN=1h